[Unit]
Description=quill-dash — meeting recordings dashboard
After=network-online.target

[Service]
WorkingDirectory=__DASH_DIR__
Environment="PATH=__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=__DASH_DIR__/.venv/bin/uvicorn app.main:app --host __BIND__ --port __PORT__
UMask=0077
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
