#!/bin/zsh
# quill-sync — push finished quill sessions to the quill-dash server.
# Fired by quill's on_stop hook (session dir as $1) and safe to run bare:
# every invocation checks every local transcript newest-first. A transcript
# hash marker skips completed work; remote hash probing bootstraps markers on
# upgrades. One failed session never prevents later sessions from uploading.
#
# Concurrency: an atomic lock dir serializes overlapping invocations (hook
# firing while a manual run is live). Transcodes go to a temp name + atomic
# rename so a parallel reader can never ship a half-written file.

set -u

# Config: ~/.config/quill-dash/sync.conf (shell syntax), e.g.
#   REMOTE="user@your-server"                 # ssh target running quill-dash
#   REMOTE_DIR="/home/user/quill-data/sessions"
#   DASH_URL="http://localhost:7435"          # dashboard as seen FROM the server
#   RECORDINGS="$HOME/Recordings"             # optional, this is the default
# A GUI/login-item-launched recorder hands us a minimal PATH — Homebrew's bin
# dirs are missing, so ffmpeg (mixed track) would silently never run.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

CONF="${QUILL_SYNC_CONF:-$HOME/.config/quill-dash/sync.conf}"
[[ -f "$CONF" ]] && source "$CONF"
REMOTE="${REMOTE:-}"
REMOTE_DIR="${REMOTE_DIR:-/home/$(whoami)/quill-data/sessions}"
DASH_URL="${DASH_URL:-http://localhost:7435}"
RECORDINGS="${RECORDINGS:-$HOME/Recordings}"
LOG="${QUILL_SYNC_LOG:-$HOME/.local/state/quill-sync.log}"
LOCK="${QUILL_SYNC_LOCK:-$HOME/.local/state/quill-sync.lock}"
PENDING="${QUILL_SYNC_PENDING:-$HOME/.local/state/quill-sync.pending}"
LOCK_OWNER="$LOCK/owner-pid"
RSYNC_BIN="${QUILL_RSYNC_BIN:-$(command -v rsync 2>/dev/null)}"
SSH_BIN="${QUILL_SSH_BIN:-$(command -v ssh 2>/dev/null)}"
SHASUM_BIN="${QUILL_SHASUM_BIN:-$(command -v shasum 2>/dev/null)}"
FFMPEG_BIN="${QUILL_FFMPEG_BIN:-$(command -v ffmpeg 2>/dev/null)}"
AFCONVERT_BIN="${QUILL_AFCONVERT_BIN:-/usr/bin/afconvert}"
RETRY_DELAY="${QUILL_SYNC_RETRY_DELAY:-3}"
mkdir -p "$(dirname "$LOG")"
mkdir -p "$(dirname "$PENDING")"

log() { echo "$(date '+%F %T') $*" >> "$LOG"; }
notify() {
  [[ "${QUILL_NO_NOTIFY:-0}" == 1 ]] && return
  /usr/bin/osascript -e "display notification \"$2\" with title \"$1\"" 2>/dev/null
}

# Atomic PID-owned lock. Elapsed time cannot define staleness because a slow
# multi-track upload can legitimately run for hours. A dead owner is reclaimed;
# a live owner gets a pending flag and performs another scan before it exits.
if mkdir "$LOCK" 2>/dev/null; then
  printf '%s\n' "$$" > "$LOCK_OWNER"
else
  owner_pid=""
  [[ -f "$LOCK_OWNER" ]] && owner_pid="$(<"$LOCK_OWNER")"
  owner_alive=0
  if [[ "$owner_pid" =~ '^[0-9]+$' ]] && kill -0 "$owner_pid" 2>/dev/null; then
    owner_alive=1
  fi

  # A missing owner can occur during the tiny mkdir/write window, or when an
  # older uploader version owns the lock. Preserve the legacy 30-minute grace
  # only for that upgrade case; all new locks use process liveness.
  if (( owner_alive )) \
      || { [[ -z "$owner_pid" ]] \
           && [[ -z "$(find "$LOCK" -maxdepth 0 -mmin +30 2>/dev/null)" ]]; }; then
    : > "$PENDING"
    log "another sync is running; rescan requested"
    exit 0
  fi

  [[ -f "$LOCK_OWNER" ]] && rm -f "$LOCK_OWNER"
  if rmdir "$LOCK" 2>/dev/null && mkdir "$LOCK" 2>/dev/null; then
    printf '%s\n' "$$" > "$LOCK_OWNER"
    log "reclaimed sync lock from dead owner ${owner_pid:-legacy}"
  else
    : > "$PENDING"
    log "lock contention; rescan requested"
    exit 0
  fi
fi

cleanup_lock() {
  local owner_pid=""
  [[ -f "$LOCK_OWNER" ]] && owner_pid="$(<"$LOCK_OWNER")"
  if [[ "$owner_pid" == "$$" ]]; then
    rm -f "$LOCK_OWNER"
    rmdir "$LOCK" 2>/dev/null || true
  fi
}
trap cleanup_lock EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

fail() {
  log "FAIL: $1"
  notify "quill sync failed" "$1 — will retry on next recording"
  exit 1
}

[[ -n "$RSYNC_BIN" && -x "$RSYNC_BIN" ]] || fail "rsync missing"
[[ -n "$SSH_BIN" && -x "$SSH_BIN" ]] || fail "ssh missing"
[[ -n "$SHASUM_BIN" && -x "$SHASUM_BIN" ]] || fail "shasum missing"
[[ -n "$REMOTE" ]] || fail "no REMOTE configured (see $CONF)"

transcode() {  # $1 src.caf  $2 dst.m4a
  local tmp="$2.tmp-$$.m4a"
  if "$AFCONVERT_BIN" -f m4af -d aac -b 64000 "$1" "$tmp" 2>> "$LOG"; then
    mv -f "$tmp" "$2"
  else
    rm -f "$tmp"; return 1
  fi
}

write_marker() {  # $1 marker path  $2 transcript hash
  local marker_tmp="$1.tmp-$$"
  printf '%s\n' "$2" > "$marker_tmp"
  mv -f "$marker_tmp" "$1"
}

dashboard_ingest() {  # $1 session id
  "$SSH_BIN" -o ConnectTimeout=10 "$REMOTE" \
    "curl -fsS --max-time 30 -X POST $DASH_URL/api/ingest/$1 -o /dev/null"
}

synced=0
ingested=0
skipped=0
failed=0
for dir in "$RECORDINGS"/*(N/On); do
  id="${dir:t}"
  [[ -f "$dir/transcript.json" ]] || continue
  if [[ ! "$id" =~ '^[A-Za-z0-9._-]+$' ]]; then
    log "FAIL: unsafe session id skipped: $id"
    failed=$((failed+1))
    continue
  fi
  marker="$dir/.quill-synced.sha256"
  ingest_marker="$dir/.quill-ingested.sha256"
  local_hash=$("$SHASUM_BIN" -a 256 "$dir/transcript.json" | awk '{print $1}')

  if [[ -f "$marker" && "$(<"$marker")" == "$local_hash" ]]; then
    skipped=$((skipped+1))
    continue
  fi

  # Phase 1: make notes visible before moving large audio. A separate ingest
  # marker lets later runs skip this phase while incomplete audio resumes.
  if [[ ! -f "$ingest_marker" || "$(<"$ingest_marker")" != "$local_hash" ]]; then
    remote_hash=$("$SSH_BIN" -o ConnectTimeout=10 "$REMOTE" \
      "sha256sum '$REMOTE_DIR/$id/transcript.json' 2>/dev/null | cut -d' ' -f1" \
      2>> "$LOG" || true)

    if [[ "$remote_hash" != "$local_hash" ]]; then
      metadata_ok=0
      for attempt in 1 2 3; do
        if "$RSYNC_BIN" -a --timeout=120 --partial-dir=.rsync-partial \
          -e "$SSH_BIN -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=8" \
          --include="transcript.json" --include="meta.json" \
          --include="transcribe.log" --exclude="*" \
          "$dir/" "$REMOTE:$REMOTE_DIR/$id/" >> "$LOG" 2>&1; then
          metadata_ok=1
          break
        fi
        log "metadata rsync $id attempt $attempt/3 failed"
        (( attempt < 3 && RETRY_DELAY > 0 )) && sleep $((RETRY_DELAY * attempt))
      done
      if (( ! metadata_ok )); then
        log "FAIL: metadata rsync $id (will retry without blocking other sessions)"
        failed=$((failed+1))
        continue
      fi
    fi

    if ! dashboard_ingest "$id" >> "$LOG" 2>&1; then
      log "ingest ping FAILED for $id"
      notify "quill sync" "$id transcript uploaded but ingest failed — will retry"
      failed=$((failed+1))
      continue
    fi
    write_marker "$ingest_marker" "$local_hash"
    ingested=$((ingested+1))
    log "ingested $id"
  fi

  # Phase 2: audio is independent and resumable. Notes remain available even
  # when a slow network leaves this phase for the next invocation.
  for track in mic system; do
    if [[ -f "$dir/$track.caf" && ! -f "$dir/$track.m4a" ]]; then
      transcode "$dir/$track.caf" "$dir/$track.m4a" \
        || log "afconvert failed for $id/$track (that track won't play in the dashboard)"
    fi
  done

  if [[ -f "$dir/mic.caf" && -f "$dir/system.caf" && ! -f "$dir/mixed.m4a" \
        && -n "$FFMPEG_BIN" && -x "$FFMPEG_BIN" ]]; then
    tmpmix="$dir/mixed.tmp-$$.m4a"
    if "$FFMPEG_BIN" -hide_banner -loglevel error -y \
         -i "$dir/mic.caf" -i "$dir/system.caf" \
         -filter_complex "[0:a][1:a]amix=inputs=2:duration=longest:normalize=1" \
         -c:a aac -b:a 96k "$tmpmix" 2>> "$LOG"; then
      mv -f "$tmpmix" "$dir/mixed.m4a"
    else
      rm -f "$tmpmix"; log "ffmpeg mix failed for $id (falling back to separate tracks)"
    fi
  fi

  audio_files=("$dir"/*.m4a(N))
  if (( ${#audio_files} > 0 )); then
    audio_ok=0
    for attempt in 1 2 3; do
      if "$RSYNC_BIN" -a --timeout=120 --partial-dir=.rsync-partial \
        -e "$SSH_BIN -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=8" \
        --include="*.m4a" --exclude="*" \
        "$dir/" "$REMOTE:$REMOTE_DIR/$id/" >> "$LOG" 2>&1; then
        audio_ok=1
        break
      fi
      log "audio rsync $id attempt $attempt/3 failed"
      (( attempt < 3 && RETRY_DELAY > 0 )) && sleep $((RETRY_DELAY * attempt))
    done
    if (( ! audio_ok )); then
      log "FAIL: audio rsync $id (notes are live; audio will resume next run)"
      failed=$((failed+1))
      continue
    fi

    # Transcript-first ingest sees no audio yet. Refresh after media lands so
    # the dashboard exposes the available playback tracks without waiting for
    # another recording or a service restart.
    if ! dashboard_ingest "$id" >> "$LOG" 2>&1; then
      log "post-audio ingest FAILED for $id (audio is present; flags will retry)"
      failed=$((failed+1))
      continue
    fi
  else
    log "no playable audio for $id"
  fi

  write_marker "$marker" "$local_hash"
  synced=$((synced+1))
  log "synced $id"
done

log "done — ingested=$ingested synced=$synced skipped=$skipped failed=$failed"

# Release before checking the flag. A new invocation now either acquires the
# lock and performs the scan itself, or had already collided and left PENDING.
# This ordering avoids a check-then-unlock window that could strand a session.
cleanup_lock
trap - EXIT HUP INT TERM
if [[ -f "$PENDING" ]]; then
  rm -f "$PENDING"
  log "running requested rescan"
  exec "$0" "$@"
fi

if (( failed > 0 )); then
  notify "quill sync incomplete" "$failed session(s) will retry on the next run"
  exit 1
fi
