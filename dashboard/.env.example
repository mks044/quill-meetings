# quill-dash server config — copy to .env next to the app and edit.

# AI runs through the Codex CLI on this machine (flat-rate ChatGPT subscription,
# no per-token billing). Install + `codex login` first.
CODEX_BIN=/home/YOURUSER/.local/bin/codex
CODEX_MODEL=gpt-5.6-sol
SUMMARY_EFFORT=high
CHAT_EFFORT=medium

# Password gate. Leave QUILL_PASSWORD empty for a private LAN/VPN-only install
# (no login screen). If you set it, QUILL_SECRET is REQUIRED (>=16 chars) —
# generate with: openssl rand -hex 24
QUILL_PASSWORD=
QUILL_SECRET=

# Canonical public origin for share links (optional; falls back to request host)
# QUILL_PUBLIC_BASE=https://quill.example.com

# Where synced recordings + the SQLite DB live
# QUILL_DATA=/home/YOURUSER/quill-data
# QUILL_PORT=7435

# Language of AI notes ("English" or any language name)
SUMMARY_LANGUAGE=English
